# Free/demo deployment
JWT_SECRET_KEY=generate-a-long-random-secret
ALLOWED_ORIGINS=https://gkt.com.np
FRONTEND_RESET_URL=https://gkt.com.np/twins/
MAX_UPLOAD_BYTES=10485760
ACCESS_TOKEN_DAYS=30
DEV_RESET_MODE=false

# Optional password-reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@gkt.com.np

# Optional paid deployment database. Leave unset for the free SQLite demo.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
