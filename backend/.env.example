# REQUIRED IN PRODUCTION
JWT_SECRET_KEY=generate-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ALLOWED_ORIGINS=https://gkt.com.np
FRONTEND_RESET_URL=https://gkt.com.np/twins/

# Persistent filesystem on the selected backend host
STORAGE_DIR=/data
INSIGHTFACE_ROOT=/data/insightface
MAX_UPLOAD_BYTES=10485760

# Password reset email (required for real email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@gkt.com.np
DEV_RESET_MODE=false

# Optional
ACCESS_TOKEN_DAYS=30
DB_POOL_SIZE=5
ALLOW_DEV_ORIGINS=false
INSIGHTFACE_MODEL=buffalo_l
